rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ────────────────────────────────────────────────────────
    // Each user can only read and write their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Boat root document ───────────────────────────────────────────────────
    // A boat document may be created by any authenticated user, provided they
    // include themselves as the first member and owner. This lets BootstrapService
    // create the document on first launch without a chicken-and-egg problem.
    //
    // Reading, updating, or deleting requires the caller's uid to already be
    // present in the `members` array of the existing document.
    match /boats/{boatId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.members;

      // ── Boat subcollections (entries, meta/**) ───────────────────────────
      // Any uid that appears in the parent boat's `members` array may read and
      // write any subcollection document. The single `get()` call is billed as
      // one Firestore read per security-rule evaluation.
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(
              /databases/$(database)/documents/boats/$(boatId)
            ).data.members;
      }
    }

    // All other paths are denied by default.
  }
}
