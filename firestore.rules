rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(logbookId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/logbooks/$(logbookId)/members/$(request.auth.uid));
    }

    function isOwner(logbookId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/logbooks/$(logbookId))
          .data.ownerUid == request.auth.uid;
    }

    // Share-code lookup: any signed-in user can read (needed for QR join flow).
    //
    // DELIBERATE TRADE-OFF: a signed-in user who knows or guesses a share code
    // can read that document. The code space is 32^8 ≈ 1 trillion combinations
    // (alphabet: ABCDEFGHJKLMNPQRSTUVWXYZ23456789), so brute-force is not
    // practical. Listing is not possible (no 'list' rule), so guessing requires
    // knowing the exact 8-character string. Accepted risk; no change planned.
    match /shareCodes/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isMember(resource.data.logbookId);
      allow delete: if isSignedIn() && isMember(resource.data.logbookId);
    }

    // User profile: only the user themselves.
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Logbook document: any member reads; only owner writes meta.
    match /logbooks/{logbookId} {
      allow read:   if isMember(logbookId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(logbookId);

      // Day entries and logbook-scoped metadata: any member reads and writes.
      // Keep these collections explicit. A broad `/{collection}/{document=**}`
      // rule would also match `/members/...`; Firestore combines overlapping
      // matches with OR semantics, which would bypass the owner-only member
      // management rules below.
      match /entries/{document=**} {
        allow read, write: if isMember(logbookId);
      }

      match /meta/{document=**} {
        allow read, write: if isMember(logbookId);
      }

      // Members sub-collection.
      match /members/{uid} {
        // The owner can add, update, or remove anyone.
        allow write: if isOwner(logbookId);
        // Anyone signed in can add only themselves as a guest (join flow).
        allow create: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.role == 'guest';
        // Members can read the members list. A caller may also read only
        // their own membership document before joining, so the share-code
        // flow can check whether they are already connected.
        allow read: if isMember(logbookId) ||
                    (isSignedIn() && request.auth.uid == uid);
      }
    }
  }
}
