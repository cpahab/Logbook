rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(boatId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/boats/$(boatId)/members/$(request.auth.uid));
    }

    function isOwner(boatId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/boats/$(boatId))
          .data.ownerUid == request.auth.uid;
    }

    // User profile: only the user themselves.
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Boat document: any member reads; only owner writes meta.
    match /boats/{boatId} {
      allow read:  if isMember(boatId);
      allow write: if isOwner(boatId);

      // Logbook data: any member reads and writes.
      match /{collection}/{document=**} {
        allow read, write: if isMember(boatId);
      }

      // Members sub-collection.
      match /members/{uid} {
        // Owner can add/remove anyone.
        allow write: if isOwner(boatId);
        // Anyone signed in can add themselves (join flow).
        allow create: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.role == 'guest';
        // Members can read the members list.
        allow read: if isMember(boatId);
      }
    }
  }
}
