rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage access follows Firestore membership. Authentication alone is
    // not sufficient: a signed-in user who learns another logbook ID must not
    // be able to read or overwrite its GPX files and photos.
    function isMember(logbookId) {
      return request.auth != null && firestore.exists(
        /databases/(default)/documents/logbooks/$(logbookId)/members/$(request.auth.uid));
    }

    match /logbooks/{logbookId}/{allPaths=**} {
      allow read, write: if isMember(logbookId);
    }

    // TEMPORARILY REVERTED for a controlled test (see git history /
    // conversation): isolating whether the `list`-permission relaxation
    // below was the actual fix for lost GPX tracks on logbook switch, or
    // whether a slower debug build (extra time for eventual consistency)
    // was doing the real work. Re-deploy this strict version, retest with
    // the same debug logging in home_repository.dart, and check whether
    // tracks are lost again:
    //   match /logbooks/{logbookId}/tracks/{allPaths=**} {
    //     allow list: if request.auth != null;
    //   }
  }
}
