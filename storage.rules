rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage access follows Firestore membership. Authentication alone is
    // not sufficient: a signed-in user who learns another logbook ID must not
    // be able to read or overwrite its GPX files and photos.
    function isMember(logbookId) {
      return request.auth != null && firestore.exists(
        /databases/(default)/documents/logbooks/$(logbookId)/members/$(request.auth.uid));
    }

    match /logbooks/{logbookId}/{allPaths=**} {
      allow read, write: if isMember(logbookId);
    }
  }
}
