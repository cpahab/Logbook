rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logbook IDs are non-guessable Firestore auto-IDs, so authentication
    // is sufficient protection for a personal logbook app.
    // The stronger isMember() cross-service check can be restored once
    // Apple DeviceCheck / App Check is configured for release builds.
    match /logbooks/{logbookId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
