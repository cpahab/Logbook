rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All boat files (GPS tracks + photos) live under boats/{boatId}/.
    // Boat-level membership is enforced by the app; Storage rules guard
    // against unauthenticated access only.
    match /boats/{boatId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
