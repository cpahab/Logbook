rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All logbook files (GPS tracks + photos) live under logbooks/{logbookId}/.
    // Membership is enforced by Firestore rules; Storage rules guard
    // against unauthenticated access only.
    match /logbooks/{logbookId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
