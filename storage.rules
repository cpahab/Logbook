rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage access follows Firestore membership. Authentication alone is
    // not sufficient: a signed-in user who learns another logbook ID must not
    // be able to read or overwrite its GPX files and photos.
    function isMember(logbookId) {
      return request.auth != null && firestore.exists(
        /databases/(default)/documents/logbooks/$(logbookId)/members/$(request.auth.uid));
    }

    match /logbooks/{logbookId}/{allPaths=**} {
      allow read, write: if isMember(logbookId);
    }

    // GPX track filenames (dates) only. Storage's `list` operation combined
    // with a cross-service firestore.exists() check (as used by isMember
    // above) is unreliable: confirmed that single-object get/put/delete on
    // both tracks and photos work fine under the rule above, but listAll()
    // on the tracks/ prefix persistently failed — every logbook switch
    // silently lost every track, even across app relaunches, because the
    // client could never learn which dates to download. Listing only
    // reveals which dates have a track file, not the track's contents —
    // actual track data stays gated by the strict isMember check above.
    match /logbooks/{logbookId}/tracks/{allPaths=**} {
      allow list: if request.auth != null;
    }
  }
}
